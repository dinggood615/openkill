#!/bin/sh /etc/rc.common
# Independent NaiveProxy bridge.  OpenKill never calls this service.

START=90
STOP=10
USE_PROCD=1

NAIVEPROXY_STANDALONE_LIB=1 . /usr/share/openkill/naiveproxy-standalone.sh

extra_command "start_node" "Start one independent NaiveProxy node"
extra_command "stop_node" "Stop one independent NaiveProxy node"
extra_command "health" "Check independent NaiveProxy node health"

NP_SERVICE_NAME="naiveproxy-bridge"
NP_START_IDS=""

naiveproxy_record_ready() {
    local id="$1" file generation state_tmp
    file=$(np_node_file "$id") || return 1
    generation=$(np_node_generation "$file" 2>/dev/null || printf 1)
    state_tmp="$NP_STATE_DIR/instance.$id.new.$$"
    printf 'generation=%s\nstarted_at=%s\n' "$generation" "$(date +%s)" > "$state_tmp" 2>/dev/null && \
        chmod 600 "$state_tmp" 2>/dev/null && mv -f "$state_tmp" "$NP_STATE_DIR/instance.$id" 2>/dev/null || {
        rm -f "$state_tmp"
        return 1
    }
}

naiveproxy_start_instance() {
    local id="$1" file enabled config instance
    [ -n "$id" ] || return 1
    np_dirs || return 1
    if ! np_probe_component; then
        NP_FORCE_COMPONENT_PROBE=1 np_manifest >/dev/null 2>&1 || true
        return 1
    fi
    file=$(np_node_file "$id") || return 1
    [ -r "$file" ] || return 1
    # A new application attempt must never expose a result from the previous
    # process/configuration generation while procd is still starting.
    rm -f "$NP_STATE_DIR/health.$id"
    enabled=$(np_node_value "$file" enabled)
    np_enabled "$enabled" || return 0
    config=$(np_prepare "$id" 2>/dev/null || true)
    [ -r "$config" ] || return 1
    instance="naive_${id}"
    procd_open_instance "$instance"
    procd_set_param command "$NP_BIN" "$config"
    procd_set_param user root
    # The official NaiveProxy binary needs the root group for its TLS/network
    # runtime on OpenWrt.  Dropping only the group leaves a SOCKS listener
    # that accepts clients but cannot establish the upstream tunnel.
    procd_set_param group root
    procd_set_param file "$config"
    procd_set_param respawn 300 5 3
    procd_set_param stderr 1
    procd_close_instance
    NP_START_IDS="$NP_START_IDS $id"
}

naiveproxy_start_instances() {
    local id failed=0
    NP_START_IDS=""
    for id in $(np_ids); do
        naiveproxy_start_instance "$id" || failed=1
    done
    return "$failed"
}

service_started() {
    local id failed=0
    for id in $NP_START_IDS; do
        # This hook runs after rc.common has committed procd_close_service.
        if np_wait_for_ready "$id"; then
            naiveproxy_record_ready "$id" || failed=1
        else
            rm -f "$NP_STATE_DIR/instance.$id"
            rm -f "$NP_STATE_DIR/health.$id"
            failed=1
        fi
    done
    if [ "$failed" -eq 0 ] && [ -n "$NP_START_IDS" ]; then
        NP_COMPONENT_STATUS_OVERRIDE=available np_manifest >/dev/null 2>&1 || true
    else
        np_manifest >/dev/null 2>&1 || true
    fi
    return "$failed"
}

start_service() { naiveproxy_start_instances; }

start_node() {
    local id="$1" rc=0
    [ -n "$id" ] || return 1
    procd_lock
    NP_START_IDS=""
    procd_open_service "$NP_SERVICE_NAME" "$initscript"
    naiveproxy_start_instance "$id" || rc=$?
    # A targeted start must add/update only this instance.  The default
    # procd_close_service action is `set`, which replaces the service's full
    # instance table and silently drops already-running nodes.
    procd_close_service add
    [ "$rc" -eq 0 ] || { np_manifest >/dev/null 2>&1 || true; return "$rc"; }
    service_started || rc=$?
    np_manifest >/dev/null 2>&1 || true
    return "$rc"
}

stop_service() {
    local id
    procd_kill "$NP_SERVICE_NAME" >/dev/null 2>&1 || true
    for id in $(np_ids 2>/dev/null); do
        rm -f "$NP_STATE_DIR/instance.$id" "$NP_STATE_DIR/health.$id"
    done
    np_manifest >/dev/null 2>&1 || true
}

stop_node() {
    local id="$1"
    [ -n "$id" ] || return 1
    procd_lock
    procd_kill "$NP_SERVICE_NAME" "naive_$id" >/dev/null 2>&1 || true
    rm -f "$NP_STATE_DIR/instance.$id" "$NP_STATE_DIR/health.$id"
    np_manifest >/dev/null 2>&1 || true
}

reload_service() {
    stop_service
    NP_START_IDS=""
    procd_open_service "$NP_SERVICE_NAME" "$initscript"
    start_service
    local rc=$?
    procd_close_service
    [ "$rc" -eq 0 ] || return "$rc"
    service_started
}

health() { /usr/share/openkill/naiveproxy-standalone.sh health all; }
