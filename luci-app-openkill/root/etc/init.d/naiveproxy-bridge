#!/bin/sh /etc/rc.common
# Independent NaiveProxy bridge.  OpenKill never calls this service.

START=90
STOP=10
USE_PROCD=1

NAIVEPROXY_STANDALONE_LIB=1 . /usr/share/openkill/naiveproxy-standalone.sh

naiveproxy_start_instances() {
    local id file enabled config instance failed=0
    np_dirs || return 1
    if ! np_probe_component; then
        np_manifest >/dev/null 2>&1 || true
        return 1
    fi
    for id in $(np_ids); do
        file=$(np_node_file "$id") || continue
        enabled=$(np_node_value "$file" enabled)
        np_enabled "$enabled" || continue
        config=$(np_prepare "$id" 2>/dev/null || true)
        if [ ! -r "$config" ]; then
            failed=1
            continue
        fi
        instance="naive_${id}"
        procd_open_instance "$instance"
        procd_set_param command "$NP_BIN" "$config"
        procd_set_param user root
        procd_set_param group nogroup
        procd_set_param file "$config"
        procd_set_param respawn 300 5 3
        procd_set_param stderr 1
        procd_close_instance
    done
    np_manifest >/dev/null 2>&1 || true
    return "$failed"
}

start_service() { naiveproxy_start_instances; }

stop_service() {
    local id
    for id in $(np_ids 2>/dev/null); do procd_kill "naive_${id}" >/dev/null 2>&1 || true; done
    np_manifest >/dev/null 2>&1 || true
}

reload_service() { stop_service; start_service; }

health() { /usr/share/openkill/naiveproxy-standalone.sh health all; }
