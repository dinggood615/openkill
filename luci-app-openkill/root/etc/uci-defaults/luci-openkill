#!/bin/bash
. /lib/functions.sh
. /usr/share/openkill/uci.sh

[ -e "/etc/config/ucitrack" ] && {
uci -q delete ucitrack.@openkill[-1]
uci -q add ucitrack openkill
uci -q set ucitrack.@openkill[-1].init=openkill
uci -q commit ucitrack
}
uci -q delete firewall.openkill
uci -q set firewall.openkill=include
uci -q set firewall.openkill.type=script
uci -q set firewall.openkill.path=/var/etc/openkill.include
[ -n "$(command -v fw4)" ] || uci -q set firewall.openkill.reload=1
uci -q commit firewall

mkdir -p /etc/openkill/config
mkdir -p /etc/openkill/proxy_provider
mkdir -p /etc/openkill/rule_provider
mkdir -p /etc/openkill/core
mkdir -p /etc/openkill/history
mkdir -p /usr/share/openkill/backup/overwrite

mkdir -p /lib/upgrade/keep.d
cat > "/lib/upgrade/keep.d/luci-app-openkill" <<-EOF
/etc/openkill/
EOF

#Set Chnroute Format
FW4=$(command -v fw4)
ensure_route_file() {
	path="$1"
	family="$2"
	[ -f "$path" ] && return 0
	if [ -n "$FW4" ]; then
		if [ "$family" = "inet6" ]; then
			printf '%s\n' \
				'define china_ip6_route = {' \
				'}' \
				'add set inet fw4 china_ip6_route { type ipv6_addr; flags interval; auto-merge; }' \
				'add element inet fw4 china_ip6_route $china_ip6_route' > "$path"
		else
			printf '%s\n' \
				'define china_ip_route = {' \
				'}' \
				'add set inet fw4 china_ip_route { type ipv4_addr; flags interval; auto-merge; }' \
				'add element inet fw4 china_ip_route $china_ip_route' > "$path"
		fi
	elif [ "$family" = "inet6" ]; then
		printf 'create china_ip6_route hash:net family inet6 hashsize 1024 maxelem 1000000\n' > "$path"
	else
		printf 'create china_ip_route hash:net family inet hashsize 1024 maxelem 1000000\n' > "$path"
	fi
}
# A stale upgrade backup may predate the route files.  Create an empty but
# valid set definition so first boot never aborts on a missing file.
ensure_route_file "/etc/openkill/china_ip_route.ipset" inet
ensure_route_file "/etc/openkill/china_ip6_route.ipset" inet6
rm -f /tmp/china_ip_route.list /tmp/china_ip6_route.list
if [ -n "$FW4" ]; then
	#v4
	if ! grep -q "define china_ip_route" "/etc/openkill/china_ip_route.ipset"; then
		echo "define china_ip_route = {" >/tmp/china_ip_route.list
		awk '!/^$/&&!/^#/{printf("    %s,'" "'\n",$0)}' /etc/openkill/china_ip_route.ipset >>/tmp/china_ip_route.list
		echo "}" >>/tmp/china_ip_route.list
		echo "add set inet fw4 china_ip_route { type ipv4_addr; flags interval; auto-merge; }" >>/tmp/china_ip_route.list
		echo 'add element inet fw4 china_ip_route $china_ip_route' >>/tmp/china_ip_route.list
	fi
	#v6
	if ! grep -q "define china_ip6_route" "/etc/openkill/china_ip6_route.ipset"; then
		echo "define china_ip6_route = {" >/tmp/china_ip6_route.list
		awk '!/^$/&&!/^#/{printf("    %s,'" "'\n",$0)}' /etc/openkill/china_ip6_route.ipset >>/tmp/china_ip6_route.list
		echo "}" >>/tmp/china_ip6_route.list
		echo "add set inet fw4 china_ip6_route { type ipv6_addr; flags interval; auto-merge; }" >>/tmp/china_ip6_route.list
		echo 'add element inet fw4 china_ip6_route $china_ip6_route' >>/tmp/china_ip6_route.list
	fi
else
	#v4
	if ! grep -q "create china_ip_route" "/etc/openkill/china_ip_route.ipset"; then
		echo "create china_ip_route hash:net family inet hashsize 1024 maxelem 1000000" >/tmp/china_ip_route.list
		awk '!/^$/&&!/^#/{printf("add china_ip_route %s'" "'\n",$0)}' /etc/openkill/china_ip_route.ipset >>/tmp/china_ip_route.list
	fi
	#v6
	if ! grep -q "create china_ip6_route" "/etc/openkill/china_ip6_route.ipset"; then
		echo "create china_ip6_route hash:net family inet6 hashsize 1024 maxelem 1000000" >/tmp/china_ip6_route.list
		awk '!/^$/&&!/^#/{printf("add china_ip6_route %s'" "'\n",$0)}' /etc/openkill/china_ip6_route.ipset >>/tmp/china_ip6_route.list
	fi
fi
[ ! -f /tmp/china_ip_route.list ] || mv -f /tmp/china_ip_route.list /etc/openkill/china_ip_route.ipset >/dev/null 2>&1
[ ! -f /tmp/china_ip6_route.list ] || mv -f /tmp/china_ip6_route.list /etc/openkill/china_ip6_route.ipset >/dev/null 2>&1

#Set Dashboard Secret
if [ -z "$(uci_get_config "dashboard_password")" ]; then
	uci -q set openkill.config.dashboard_password="$(tr -cd 'a-zA-Z0-9' </dev/urandom 2>/dev/null| head -c8 || date +%N| md5sum |head -c8)"
fi

#Set Authentication
if [ -z "$(uci -q get openkill.@authentication[0])" ]; then
	uci_name_tmp=$(uci -q add openkill authentication)
	uci_set="uci -q set openkill.$uci_name_tmp."
	${uci_set}enabled="1"
	${uci_set}username="Clash"
	${uci_set}password="$(tr -cd 'a-zA-Z0-9' </dev/urandom 2>/dev/null| head -c8 || date +%N| md5sum |head -c8)"
fi

#Set Core Model
source "/etc/openwrt_release"
case "${DISTRIB_ARCH}" in
	aarch64_*)
		CORE_ARCH="linux-arm64"
		;;
	armeb_*)
		CORE_ARCH="0"
		;;
	arm_cortex-a5|arm_cortex-a5[^0-9]*|arm_cortex-a7|arm_cortex-a7[^0-9]*|arm_cortex-a8*|arm_cortex-a9*|arm_cortex-a12*|arm_cortex-a15*|arm_cortex-a17*)
		CORE_ARCH="linux-armv7"
		;;
	arm_arm1176jzf-s*|arm_arm1136*|arm_mpcore*)
		CORE_ARCH="linux-armv6"
		;;
	arm*)
		CORE_ARCH="linux-armv5"
		;;
	i386_*)
		CORE_ARCH="linux-386"
		;;
	mips64el_*)
		CORE_ARCH="linux-mips64le"
		;;
	mips64_*)
		CORE_ARCH="linux-mips64"
		;;
	mips_*)
		CORE_ARCH="linux-mips-softfloat"
		;;
	mipsel_*)
		CORE_ARCH="linux-mipsle-softfloat"
		;;
	riscv64*)
		CORE_ARCH="linux-riscv64"
		;;
	loongarch64*|loongarch_*)
		CORE_ARCH="linux-loong64-abi2"
		;;
	x86_64)
		CORE_ARCH="linux-amd64-v1"
		;;
	*)
		CORE_ARCH="0"
		;;
esac
# Keep the architecture separate from the user-selected release version.
# Older OpenClash-derived builds stored this in core_version and later built
# malformed asset names after a version update.
uci -q set openkill.config.core_arch="${CORE_ARCH}"

#Backup Resolvfile
if [ -n "$(uci -q get dhcp.@dnsmasq[0].resolvfile)" ]; then
   uci -q set openkill.config.default_resolvfile=$(uci -q get dhcp.@dnsmasq[0].resolvfile)
fi

# Quic-go GSO Disable
current_kernel=$(uname -r | cut -d'-' -f1)
if [ "$(printf '%s\n' "$current_kernel" "6.6" | sort -V | head -n1)" != "$current_kernel" ]; then
   uci -q set openkill.config.disable_quic_go_gso=1
fi

uci -q commit openkill

#Backup
cp -f "/etc/config/openkill" "/usr/share/openkill/backup/openkill" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_rules.list" "/usr/share/openkill/backup/openkill_custom_rules.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_rules_2.list" "/usr/share/openkill/backup/openkill_custom_rules_2.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_hosts.list" "/usr/share/openkill/backup/openkill_custom_hosts.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_fake_filter.list" "/usr/share/openkill/backup/openkill_custom_fake_filter.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_domain_dns.list" "/usr/share/openkill/backup/openkill_custom_domain_dns.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_domain_dns_policy.list" "/usr/share/openkill/backup/openkill_custom_domain_dns_policy.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_proxy_server_dns_policy.list" "/usr/share/openkill/backup/openkill_custom_proxy_server_dns_policy.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_fallback_filter.yaml" "/usr/share/openkill/backup/openkill_custom_fallback_filter.yaml" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_sniffer.yaml" "/usr/share/openkill/backup/openkill_custom_sniffer.yaml" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_localnetwork_ipv4.list" "/usr/share/openkill/backup/openkill_custom_localnetwork_ipv4.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_localnetwork_ipv6.list" "/usr/share/openkill/backup/openkill_custom_localnetwork_ipv6.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_chnroute_pass.list" "/usr/share/openkill/backup/openkill_custom_chnroute_pass.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_chnroute6_pass.list" "/usr/share/openkill/backup/openkill_custom_chnroute6_pass.list" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_firewall_rules.sh" "/usr/share/openkill/backup/openkill_custom_firewall_rules.sh" >/dev/null 2>&1
cp -f "/etc/openkill/custom/openkill_custom_overwrite.sh" "/usr/share/openkill/backup/openkill_custom_overwrite.sh" >/dev/null 2>&1
cp -f "/etc/openkill/china_ip_route.ipset" "/usr/share/openkill/backup/china_ip_route.ipset" >/dev/null 2>&1
cp -f "/etc/openkill/china_ip6_route.ipset" "/usr/share/openkill/backup/china_ip6_route.ipset" >/dev/null 2>&1
cp -f "/etc/openkill/overwrite/default" "/usr/share/openkill/backup/overwrite/default" >/dev/null 2>&1
cp -f "/etc/openkill/rule_provider/oc-cn-domain.mrs" "/usr/share/openkill/backup/oc-cn-domain.mrs" >/dev/null 2>&1

#Restore
if [ -f "/tmp/openkill.bak" ]; then
	#delete old geosite database first
	if [ "/etc/openkill/GeoSite.dat" -nt "/tmp/openkill/GeoSite.dat" ]; then
		rm -rf "/tmp/openkill/GeoSite.dat" >/dev/null 2>&1
	fi
	#delete error china_ip_route first
	if [ -n "$FW4" ]; then
		if [ -f "/tmp/openkill/china_ip_route.ipset" ] && ! grep -q "define china_ip_route" "/tmp/openkill/china_ip_route.ipset"; then
			rm -f "/tmp/openkill/china_ip_route.ipset" >/dev/null 2>&1
			rm -f "/tmp/openkill/china_ip6_route.ipset" >/dev/null 2>&1
		fi
	else
		if [ -f "/tmp/openkill/china_ip_route.ipset" ] && ! grep -q "create china_ip_route" "/tmp/openkill/china_ip_route.ipset"; then
			rm -f "/tmp/openkill/china_ip_route.ipset" >/dev/null 2>&1
			rm -f "/tmp/openkill/china_ip6_route.ipset" >/dev/null 2>&1
		fi
	fi
	mv -f "/tmp/openkill.bak" "/etc/config/openkill" >/dev/null 2>&1
	cp -rf "/tmp/openkill/." "/etc/openkill/" >/dev/null 2>&1
	#ui
	if [ -d "/tmp/openkill_ui/" ]; then
		if [ -d "/tmp/openkill_ui/metacubexd/" ] || [ -d "/tmp/openkill_ui/zashboard/" ] || [ -d "/tmp/openkill_ui/yacd/" ] || [ -d "/tmp/openkill_ui/dashboard/" ]; then
			rm -rf "/usr/share/openkill/ui/" >/dev/null 2>&1
			cp -rf "/tmp/openkill_ui/." "/usr/share/openkill/ui/" >/dev/null 2>&1
		fi
		rm -rf "/tmp/openkill_ui/" >/dev/null 2>&1
	fi
	#pac
	if [ -d "/tmp/pac/" ]; then
		rm -rf "/www/luci-static/resources/openkill/pac/" >/dev/null 2>&1
		cp -rf "/tmp/pac/." "/www/luci-static/resources/openkill/pac/" >/dev/null 2>&1
		rm -rf "/tmp/pac/" >/dev/null 2>&1
	fi
	#oc-domain
	if [ -f "/etc/openkill/rule_provider/oc-cn-domain.mrs" ]; then
		cp -f "/usr/share/openkill/backup/oc-cn-domain.mrs" "/etc/openkill/rule_provider/oc-cn-domain.mrs" >/dev/null 2>&1
	fi
	rm -rf "/etc/openkill/openkill" >/dev/null 2>&1
	rm -rf "/tmp/openkill" >/dev/null 2>&1
	rm -rf "/tmp/openkill.bak" >/dev/null 2>&1
	#old version files
	rm -rf "/etc/openkill/fake_filter.list" >/dev/null 2>&1
	rm -rf "/etc/openkill/openkill_servers_fake_filter.conf" >/dev/null 2>&1
	rm -rf "/etc/openkill/core/clash" >/dev/null 2>&1
	rm -rf "/etc/openkill/core/clash_tun" >/dev/null 2>&1
	rm -rf "/etc/openkill/accelerated-domains.china.conf" >/dev/null 2>&1
	rm -rf "/etc/openkill/custom/openkill_force_sniffing_domain.yaml" >/dev/null 2>&1
	rm -rf "/etc/openkill/custom/openkill_sniffing_ports_filter.yaml" >/dev/null 2>&1
	rm -rf "/etc/openkill/custom/openkill_sniffing_port_filter.yaml" >/dev/null 2>&1
	rm -rf "/etc/openkill/custom/openkill_sniffing_domain_filter.yaml" >/dev/null 2>&1
	rm -rf "/etc/openkill/backup" >/dev/null 2>&1
fi

if [ -f "/usr/lib/lua/luci/model/network.lua" ]; then
   sed -i '/OpenKill Append/,/OpenKill Append End/d' "/usr/lib/lua/luci/model/network.lua" >/dev/null 2>&1
   cat >> "/usr/lib/lua/luci/model/network.lua" << EOF
-------------- OpenKill Append --------------

function get_all_wan_networks(self)
	local k, v
	local wan_nets = { }
	local route_statuses = self:get_all_status_by_route("0.0.0.0", 0)

	for k, v in pairs(route_statuses) do
		wan_nets[#wan_nets+1] = network(k, v.proto)
	end

	return wan_nets
end

function get_all_wan6_networks(self)
	local k, v
	local wan6_nets = { }
	local route_statuses = self:get_all_status_by_route("::", 0)

	for k, v in pairs(route_statuses) do
		wan6_nets[#wan6_nets+1] = network(k, v.proto)
	end

	return wan6_nets
end

function get_all_status_by_route(self, addr, mask)
	local route_statuses = { }
	local _, object
	for _, object in ipairs(utl.ubus()) do
		local net = object:match("^network%.interface%.(.+)")
		if net then
			local s = utl.ubus(object, "status", {})
			if s and s.route then
				local rt
				for _, rt in ipairs(s.route) do
					if not rt.table and rt.target == addr and rt.mask == mask then
						route_statuses[net] = s
					end
				end
			end
		end
	end

	return route_statuses
end

-------------- OpenKill Append End --------------
EOF
fi

#set uhttpd && HTTP_MAX_CONTENT for large file edit
uci -q set uhttpd.main.max_requests=50
uci -q set uhttpd.main.max_connections=100
uci -q set uhttpd.main.script_timeout=3600
uci -q commit uhttpd
sed -i '/.*kB maximum content size*/c\HTTP_MAX_CONTENT = 1024*10240		-- 100 kB maximum content size' /usr/lib/lua/luci/http.lua >/dev/null 2>&1
sed -i '/.*kB maximum content size*/c\export let HTTP_MAX_CONTENT = 1024*10240;		// 100 kB maximum content size' /usr/share/ucode/luci/http.uc >/dev/null 2>&1

/etc/init.d/uhttpd restart >/dev/null 2>&1

rm -rf /tmp/luci-indexcache /tmp/luci-indexcache.* /var/luci-indexcache /var/luci-indexcache.* >/dev/null 2>&1
rm -rf /tmp/luci-modulecache /var/luci-modulecache >/dev/null 2>&1
exit 0
